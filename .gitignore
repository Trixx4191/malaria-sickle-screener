# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Data —  raw genomic data
data/raw/
data/processed/
data/external/
*.gz
*.vcf
*.bcf
*.bam
*.sam

# Models — large files, use Git LFS or HF Hub instead
outputs/models/*.pkl
outputs/models/*.joblib

# Keep the directory structure
!outputs/models/.gitkeep
!outputs/figures/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Notebooks — output cells can be large
notebooks/.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Node / frontend tooling
node_modules/
webapp/frontend/node_modules/
webapp/frontend/dist/
webapp/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
